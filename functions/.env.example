# ライセンスキーの控えメール送信用の設定（任意）。
# このファイルをコピーして functions/.env を作り、値を入れるとメール送信が有効になる。
# SMTP_HOST / SMTP_USER / MAIL_FROM のどれかが空のあいだは送信をスキップする（キー発行は通常どおり動く）。
#
# パスワードだけは .env に書かず、Secret Manager に入れること:
#   firebase functions:secrets:set SMTP_PASS
#
# Google Workspace（studio@kokokikaku.com）から送る場合の例。
# アプリパスワード（2段階認証の設定画面で発行）を SMTP_PASS に入れる。
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=studio@kokokikaku.com
MAIL_FROM=MiseFits <studio@kokokikaku.com>

# 誤発行防止用（任意）。MiseFits Pro の Price ID を入れると、その商品の決済だけキーを発行する。
STRIPE_PRICE_ID=
